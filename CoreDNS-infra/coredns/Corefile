
# DNS-infra для эксперементов

lan.:53 {

    # авто-подхват правок Corefile каждые 15 секунд
    reload 15s

    # логируем ошибки плагинов
    # errors                     

    # статические хосты для зоны lan.
    hosts {                  
        172.20.0.10 bdsm.lan
        172.20.109.10 proxy.lan

        # Все домены, которые публикует центральный Caddy, должны
        # резолвиться в его macvlan IP и жить в DNS-infra.
        172.20.109.10 git.lan
        172.20.109.10 erp.lan
        172.20.109.10 s3.lan
        172.20.109.10 console.s3.lan
        172.20.109.10 api.s3.lan


        # короткий TTL для быстрого обновления
        ttl 15       
              
    }

    # Wildcard для бакетов и прочих поддоменов, которые Caddy
    # проксирует через блок *.s3.lan.
    template IN A {
        match (^.*\.s3\.lan\.$)
        answer "{{ .Name }} 15 IN A 172.20.109.10"
    }


    # кеш ответов внутри зоны
    cache 15                  

    # точечный лог запросов по зоне lan.
    #log                    

    # отвечаем отказом на ANY, чтобы не раздувать ответы
    any                       
}




