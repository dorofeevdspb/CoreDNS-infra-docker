lan.:53 {
    log
    errors
    reload 30s
    hosts {
        172.20.0.1 router.lan
        172.20.0.5 server.lan
        172.20.0.10 storage.lan
        172.20.0.14 printer.lan
        172.20.10.10 wg.lan
        172.20.100.10 dns.lan
        172.20.101.10 ca.lan
        172.20.102.10 docker.lan
        172.20.103.10 git.lan
        172.20.104.10 ci.lan
        172.20.105.101 01-agent.ci.lan
        172.20.105.102 02-agent.ci.lan
        172.20.105.103 03-agent.ci.lan
        172.20.106.10 test.lan
        172.20.0.5 s3.lan api.s3.lan console.s3.lan
        ttl 30
    }

    # Wildcard for bucket-style S3 requests:
    #   <bucket>.s3.lan -> Caddy (then proxied to RustFS)
    # Keep this AFTER hosts so explicit records win.
    template IN A {
        match ^([^.]+)\.s3\.lan\.$
        answer "{{ .Name }} 30 IN A 172.20.0.5"
    }
    cache 30
}

.:53 {
    log
    errors
    reload 30s
    health {
        lameduck 5s
    }
    ready
    prometheus :9153
    forward . 8.8.8.8 8.8.4.4
    cache 30
}


